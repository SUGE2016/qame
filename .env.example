DB_PASSWORD=change_me
JWT_SECRET=change_me_jwt
PASSWORD_SALT=your_fixed_salt_here
ADMIN_PASSWORD=admin123
INTERNAL_SERVICE_KEY=internal-service-secret
# QAME_ENV=production 时拒绝默认 JWT/盐/管理员密码，且要求 INTERNAL_SERVICE_KEY
QAME_ENV=development
# 额外 CORS 源（逗号分隔）；默认已含 localhost / PUBLIC_URL
# CORS_ORIGINS=https://example.com
AI_SERVICE_TIMEOUT=30000
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 前端构建用；留空则大厅走同源相对路径（经 nginx）
PUBLIC_URL=
# 若 Docker daemon 配了 HTTP 代理，compose 已为平台设置 NO_PROXY（游戏服务名）

# 平台 → 游戏服务（compose 内默认值如下，一般无需改）
# GAME_TTT_URL=http://game-tic-tac-toe:8101
# GAME_GOMOKU_URL=http://game-gomoku:8102
# GAME_BATTLESHIP_URL=http://game-battleship:8103
